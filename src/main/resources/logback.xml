<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Diagnostics/solver-progress go to STDERR so STDOUT carries only the
         generated test lines. This keeps `jenny ... | wc -l`, stdout redirection,
         and the `-o` round-trip clean (see PR #15 review finding C2). -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger level -->
    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>

    <!-- Timefold solver logging - can be adjusted for debugging -->
    <logger name="ai.timefold.solver" level="INFO" />

    <!-- Suppress verbose Timefold startup logging during tests -->
    <logger name="ai.timefold.solver.core.impl.solver.DefaultSolver" level="WARN" />
</configuration>
